def etapa_para_retomar(est):
    """Última etapa de trabalho antes do erro, pelo historico. devolvido volta como front."""
    for h in reversed(est.get("historico", [])):
        etapa = h.get("etapa")
        if etapa == "devolvido":
            return "front"
        if etapa in ETAPAS_RETOMAVEIS:
            return etapa
    return None
